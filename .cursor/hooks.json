{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node server/chief/ecc/cursorHook.js beforeShellExecution",
        "failClosed": true,
        "timeout": 15
      }
    ],
    "preToolUse": [
      {
        "command": "node server/chief/ecc/cursorHook.js preToolUse",
        "failClosed": true,
        "timeout": 15
      }
    ],
    "afterFileEdit": [
      {
        "command": "node server/chief/ecc/cursorHook.js afterFileEdit",
        "failClosed": true,
        "timeout": 15
      }
    ]
  }
}
