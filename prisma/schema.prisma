generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum PlaidItemStatus {
  CONNECTED
  REQUIRES_ATTENTION
  DISCONNECTED
}

enum TransactionSource {
  MANUAL
  PLAID
  IMPORT
  SYSTEM
}

// ── Freedom OS agent platform ────────────────────────────────────────────────

enum CeoPersonalityPreset {
  DIRECT_EFFICIENT
  WARM_ENCOURAGING
  FORMAL
}

// Trust is staged: all four levels exist in the schema now, but the runtime
// only honors READ_ONLY and DRAFT_ONLY in this phase. ACTION_REQUIRED_APPROVAL
// and AUTONOMOUS are schema-ready only and unlock in later phases.
enum AgentPermissionLevel {
  READ_ONLY
  DRAFT_ONLY
  ACTION_REQUIRED_APPROVAL
  AUTONOMOUS
}

enum AgentStatus {
  ACTIVE
  PAUSED
}

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum AgentChatRole {
  USER
  AGENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum BrainJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// Durable CEO Plan status — executive memory, not conversation workflow.
enum PlanStatus {
  ACTIVE
  WAITING
  COMPLETED
  ABANDONED
}

model User {
  id                  String               @id
  email               String?              @unique
  displayName         String?
  photoURL            String?
  // Enforced server-side via server/auth/workspaceRole.js: managing financial
  // connections (link / refresh / delete Plaid data) requires OWNER or ADMIN,
  // so role-gated actions stay closed by default for future invited MEMBERs.
  role                WorkspaceRole        @default(OWNER)
  // Platform administrator (usage reporting / admin panel). Distinct concern
  // from WorkspaceRole above, which is the household workspace role.
  // Nullable WITHOUT @default on purpose: Prisma includes @default columns in
  // every INSERT, which would break all User writes during the window where
  // new code runs against a not-yet-migrated database (the repo's
  // schema-compatibility tolerance). NULL means false; check `isAdmin === true`.
  isAdmin             Boolean?
  isDisabled          Boolean              @default(false)
  lastLoginAt         DateTime?
  // Server-side proof of Terms of Service / Privacy Policy acceptance. These
  // hold the LATEST acceptance (fast path for enforcement); the full audit
  // trail lives in legalConsentEvents. legalConsentAt is stamped with the
  // server clock; legalConsentVersion records which revision was accepted.
  legalConsentAt      DateTime?
  legalConsentVersion String?
  legalConsentEvents  LegalConsentEvent[]
  // IANA timezone for schedules / display (e.g. "America/New_York"). Null until
  // the client detects it or the user sets it in Settings / CEO chat. When null,
  // runtime resolves to America/New_York (Eastern) — never UTC.
  timezone            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  plaidItems          PlaidItem[]
  accounts            Account[]
  transactions        Transaction[]
  budgetRows          BudgetRow[]
  incomeStreams       IncomeStream[]
  subscriptions       Subscription[]
  planYears           PlanYear[]
  merchantRules       MerchantCategoryRule[]
  metricSnapshots     MetricSnapshot[]
  workspaceSnapshot   WorkspaceSnapshot?
  ceoAgentConfig      CeoAgentConfig?
  agentConfigs        AgentConfig[]
  agentRuns           AgentRun[]
  agentConversations  AgentConversation[]
  agentChatMessages   AgentChatMessage[]
  ceoDocuments        CeoDocument[]
  notifications       Notification[]
  brainJobs           BrainJob[]
  plans               Plan[]
  // Module 03 (CHIEF) back-relations. CHIEF tables reference ONLY User among
  // non-CHIEF tables (docs/CHIEF_ARCHITECTURE.md §5.4) — additive-only edit.
  chiefSessions           ChiefSession[]
  chiefTranscriptDeltas   ChiefTranscriptDelta[]
  chiefExecutionJournal   ChiefExecutionJournal[]
  chiefEventJournal       ChiefEventJournal[]
  chiefMiddlewareStates   ChiefMiddlewareState[]
  chiefAgents             ChiefAgent[]
  chiefAgentTasks         ChiefAgentTask[]
  chiefAgentMessages      ChiefAgentMessage[]
  chiefTraces             ChiefTrace[]
  chiefTraceSteps         ChiefTraceStep[]
  chiefFacts              ChiefFact[]
  chiefKnowledgeEntities  ChiefKnowledgeEntity[]
  chiefKnowledgeRelations ChiefKnowledgeRelation[]
  chiefScheduledTasks     ChiefScheduledTask[]
  chiefTaskRuns           ChiefTaskRun[]
  chiefApprovals          ChiefApproval[]
  chiefCapabilityGrants   ChiefCapabilityGrant[]
  chiefAuditLogs          ChiefAuditLog[]
  chiefBudgets            ChiefBudget[]
}

model PlaidItem {
  id                    String          @id @default(cuid())
  userId                String
  workspaceUserId       String?
  itemId                String          @unique
  institutionId         String?
  institutionName       String?
  accessTokenCiphertext String
  cursor                String?
  environment           String?
  status                PlaidItemStatus @default(CONNECTED)
  products              Json?
  lastSyncAt            DateTime?
  lastSyncError         String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts              Account[]
  transactions          Transaction[]

  @@index([userId])
  @@index([userId, workspaceUserId])
}

model Account {
  id                String        @id @default(cuid())
  userId            String
  workspaceUserId   String?
  plaidItemRecordId String?
  plaidAccountId    String?       @unique
  name              String
  type              String
  institution       String?
  status            String?
  // Financial values are encrypted at rest (envelope encryption). The plaintext
  // columns remain only to read/backfill legacy rows and are dropped in a
  // follow-up migration once backfilled; new writes always set NULL there.
  balance           Decimal?      @db.Decimal(14, 2)
  balanceCiphertext String?
  syncSource        String?
  plaidType         String?
  plaidSubtype      String?
  lastSyncedAt      DateTime?
  metadata          Json?
  metadataCiphertext String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItem         PlaidItem?    @relation(fields: [plaidItemRecordId], references: [id], onDelete: SetNull)
  transactions      Transaction[]
  subscriptions     Subscription[]

  @@index([userId])
  @@index([userId, workspaceUserId])
}

model Transaction {
  id                 String            @id @default(cuid())
  userId             String
  workspaceUserId    String?
  accountId          String?
  plaidItemRecordId  String?
  plaidTransactionId String?           @unique
  source             TransactionSource @default(MANUAL)
  syncSource         String?
  // Financial/behavioural values are encrypted at rest. Plaintext columns are
  // nullable only to read/backfill legacy rows and are dropped once backfilled.
  merchant           String?
  merchantCiphertext String?
  category           String?
  categoryCiphertext String?
  amount             Decimal?          @db.Decimal(14, 2)
  amountCiphertext   String?
  postedAt           DateTime
  authorizedAt       DateTime?
  pending            Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account            Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  plaidItem          PlaidItem?        @relation(fields: [plaidItemRecordId], references: [id], onDelete: SetNull)

  @@index([userId, postedAt])
  @@index([accountId, postedAt])
  @@index([userId, workspaceUserId, postedAt])
}

model PlanYear {
  id                   String         @id @default(cuid())
  userId               String
  year                 Int
  startingMonth        String
  startingTrueCash     Decimal        @db.Decimal(14, 2)
  projectionAdjustments Json
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetRows           BudgetRow[]
  incomeStreams        IncomeStream[]

  @@unique([userId, year])
  @@index([userId])
}

model BudgetRow {
  id                    String    @id @default(cuid())
  userId                String
  planYearId            String
  name                  String
  icon                  String?
  color                 String?
  budget                Decimal   @db.Decimal(14, 2)
  transactionCategories Json
  months                Json
  position              Int       @default(0)
  type                  String    @default("O")
  reserveTargetMonths   Int       @default(12)
  reserveAnchor         Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planYear              PlanYear  @relation(fields: [planYearId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planYearId, position])
}

model IncomeStream {
  id          String    @id @default(cuid())
  userId      String
  planYearId  String
  name        String
  description String?
  amount      Decimal   @db.Decimal(14, 2)
  type        String
  color       String?
  icon        String?
  months      Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planYear    PlanYear  @relation(fields: [planYearId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planYearId])
}

model Subscription {
  id          String    @id @default(cuid())
  userId      String
  accountId   String?
  name        String
  amount      Decimal   @db.Decimal(14, 2)
  frequency   String
  category    String?
  billingDay  Int?
  status      String
  icon        String?
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model MerchantCategoryRule {
  id          String    @id @default(cuid())
  userId      String
  merchantKey String
  category    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantKey])
}

model MetricSnapshot {
  id             String    @id @default(cuid())
  userId         String
  snapshotDate   DateTime
  liquidCash     Decimal   @db.Decimal(14, 2)
  creditCardDebt Decimal   @db.Decimal(14, 2)
  totalNetWorth  Decimal   @db.Decimal(14, 2)
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, snapshotDate])
  @@index([userId, snapshotDate])
}

// Immutable audit trail of every legal-consent acceptance. Retaining history
// (not just the latest version on User) is important for a fintech: it proves
// when a user accepted each revision of the Terms/Privacy Policy.
model LegalConsentEvent {
  id        String   @id @default(cuid())
  userId    String
  version   String
  method    String?
  consentAt DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentAt])
}

model WorkspaceSnapshot {
  id                  String   @id @default(cuid())
  userId              String   @unique
  // The workspace blob holds manual financial data (budgets, income, reserves,
  // manual accounts/transactions). It is encrypted at rest in stateCiphertext;
  // the legacy plaintext `state` column is read-only for migration and set NULL
  // on every new write.
  state               Json?
  stateCiphertext     String?
  source              String?
  lastClientUpdatedAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// The per-user orchestrator (the CEO Agent itself, not a sub-agent) — exactly
// one per user. Personality is preset-driven by design: no free-text system
// prompts, and avatarKey identifies a preset avatar (not a URL, no AI
// generation).
model CeoAgentConfig {
  id                   String               @id @default(cuid())
  userId               String               @unique
  name                 String               @default("CEO Agent")
  personalityPreset    CeoPersonalityPreset @default(DIRECT_EFFICIENT)
  // User-selected Anthropic tier for CEO chat / digest / narrative profile.
  model                String               @default("claude-sonnet-4-5")
  // Default model applied when creating new sub-agents (independent of CEO model).
  defaultSubAgentModel String               @default("claude-sonnet-4-5")
  avatarKey            String?
  // The encrypted "living profile": long-term shared memory that all agents
  // read and feed. Decrypted JSON shape — categories financialGoals,
  // knownAccountsRelationships, statedPreferences, recurringConcerns,
  // lifeContext; each entry { id, text, source, addedAt, updatedAt } where
  // source is onboarding | user_edit | an agent type; plus a tombstones array
  // of removed-entry ids so automatic merging never re-adds what the user
  // deleted.
  profileCiphertext    String?
  profileUpdatedAt     DateTime?
  // Cached CEO digest (encrypted) so opening the dashboard doesn't require a
  // fresh LLM call.
  lastDigestCiphertext String?
  lastDigestAt         DateTime?
  // Encrypted narrative summary produced after onboarding (and refreshable).
  onboardingSummaryCiphertext String?
  onboardingSummaryAt  DateTime?
  // Long-form newsletter-style profile (encrypted), generated on demand from
  // living profile facts + CEO chat history + created agents. Separate from
  // the short onboarding summary shown above Reference documents.
  narrativeProfileCiphertext String?
  narrativeProfileAt   DateTime?
  onboardingCompletedAt DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentConfigs         AgentConfig[]
  agentConversations   AgentConversation[]
  agentChatMessages    AgentChatMessage[]
  ceoDocuments         CeoDocument[]
}

// User-uploaded reference documents the CEO Agent can read (encrypted text
// content only — no binary blobs). Sourced during onboarding or from the
// profile page; injected into CEO chat context.
model CeoDocument {
  id                String         @id @default(cuid())
  userId            String
  ceoAgentConfigId  String
  filename          String
  mimeType          String
  sizeBytes         Int
  contentCiphertext String
  createdAt         DateTime       @default(now())
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ceoAgentConfig    CeoAgentConfig @relation(fields: [ceoAgentConfigId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([ceoAgentConfigId, createdAt])
}

// A sub-agent owned by a user and coordinated by their CEO Agent. Any number
// per user (Finance first; Research/Reminders soon; Email schema-ready only).
model AgentConfig {
  id               String               @id @default(cuid())
  userId           String
  ceoAgentConfigId String
  // Open/extensible on purpose — NOT an enum, so future agent types don't
  // require migrations. Known values now: finance, research, reminders, email.
  agentType        String
  name             String
  // Preset-guided instructions set by the agent creation flow.
  instructions     String?
  // One specific, measurable sentence describing success for this agent.
  definitionOfDone String?
  // Conversational intake identity notes (plain fields — not a soul-file system).
  personalityNotes String?
  // Explicit "will never" boundaries, plain text (newline-separated list is fine).
  boundaries       String?
  // What the agent reverse-engineered from history / examples, if anything.
  workingFromNotes String?
  permissionLevel  AgentPermissionLevel @default(READ_ONLY)
  // Per-agent LLM tier; a single tier is used at launch, but the field exists
  // so model tiering isn't a retrofit.
  model            String               @default("claude-sonnet-4-5")
  // Allowlist of data/APIs this agent may touch.
  toolAccess       Json?
  // Cron-style expression; null = on-demand only.
  schedule         String?
  status           AgentStatus          @default(ACTIVE)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  ceoAgentConfig   CeoAgentConfig       @relation(fields: [ceoAgentConfigId], references: [id], onDelete: Cascade)
  agentRuns        AgentRun[]
  agentConversations AgentConversation[]
  agentChatMessages AgentChatMessage[]
  notifications    Notification[]

  @@index([userId])
  @@index([userId, agentType])
}

// Audit log of every agent run: what was touched, what was produced, when,
// status, and cost. agentConfigId is deliberately nullable (SetNull) so the
// audit trail survives agent deletion; agentType is a denormalized copy for
// the same reason.
model AgentRun {
  id               String         @id @default(cuid())
  userId           String
  agentConfigId    String?
  agentType        String
  // Short human-readable plaintext the CEO digest consumes cheaply. Not raw
  // logs — must never contain merchant names or account identifiers.
  summary          String?
  // Description of what data the run read.
  dataAccessed     Json?
  // Full run output, encrypted at rest.
  outputCiphertext String?
  status           AgentRunStatus @default(RUNNING)
  error            String?
  // How the run was started: "manual" | "cron" | "ceo_delegate" | "chat".
  // Nullable for rows created before lineage columns existed.
  trigger          String?
  // Conversation that asked for this work (CEO or specialist thread).
  triggeredByConversationId String?
  // Optional parent run when this execution was chained from another run.
  parentRunId      String?
  // Usage accounting for per-user usage reporting in the admin panel.
  model            String?
  tokensInput      Int?
  tokensOutput     Int?
  estimatedCostUsd Decimal?       @db.Decimal(10, 6)
  startedAt        DateTime       @default(now())
  completedAt      DateTime?
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentConfig      AgentConfig?   @relation(fields: [agentConfigId], references: [id], onDelete: SetNull)
  triggeredByConversation AgentConversation? @relation("RunTriggeredByConversation", fields: [triggeredByConversationId], references: [id], onDelete: SetNull)
  parentRun        AgentRun?      @relation("AgentRunLineage", fields: [parentRunId], references: [id], onDelete: SetNull)
  childRuns        AgentRun[]     @relation("AgentRunLineage")
  chatMessages     AgentChatMessage[]

  @@index([userId, startedAt])
  @@index([agentConfigId, startedAt])
  @@index([userId, agentType, startedAt])
  @@index([triggeredByConversationId, startedAt])
  @@index([parentRunId])
}

// Multi-conversation parent for CEO and sub-agent chats. Invariant: exactly
// one of agentConfigId / ceoAgentConfigId is set — same XOR as AgentChatMessage,
// enforced in application code and by a Postgres CHECK constraint.
// isSystem=true pins flows that must not appear in the normal conversation
// list (e.g. "+ New Agent" creation); Phase 3+ APIs exclude these by default.
model AgentConversation {
  id               String         @id @default(cuid())
  userId           String
  agentConfigId    String?
  ceoAgentConfigId String?
  // Plaintext list title for v1 (snippet / async rename in later phases).
  title            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  archivedAt       DateTime?
  isSystem         Boolean        @default(false)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentConfig      AgentConfig?   @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)
  ceoAgentConfig   CeoAgentConfig? @relation(fields: [ceoAgentConfigId], references: [id], onDelete: Cascade)
  messages         AgentChatMessage[]
  triggeredRuns    AgentRun[]     @relation("RunTriggeredByConversation")

  @@index([userId, agentConfigId, updatedAt])
  @@index([userId, ceoAgentConfigId, updatedAt])
  @@index([userId, updatedAt])
}

// One table serves both CEO chat and every sub-agent chat. Invariant: exactly
// one of agentConfigId / ceoAgentConfigId is set — enforced in application
// code and by a Postgres CHECK constraint in the migration SQL:
//   (("agentConfigId" IS NULL) <> ("ceoAgentConfigId" IS NULL))
// conversationId scopes messages to one AgentConversation thread; agent XOR
// columns stay denormalized for target checks and legacy lookbacks.
model AgentChatMessage {
  id                String          @id @default(cuid())
  userId            String
  conversationId    String
  agentConfigId     String?
  ceoAgentConfigId  String?
  role              AgentChatRole
  // Chat content is sensitive and encrypted at rest.
  contentCiphertext String
  // Links a message to the specific run it asks about ("why did you flag
  // this?"). SetNull so chat history survives run pruning.
  relatedRunId      String?
  createdAt         DateTime        @default(now())
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation      AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentConfig       AgentConfig?    @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)
  ceoAgentConfig    CeoAgentConfig? @relation(fields: [ceoAgentConfigId], references: [id], onDelete: Cascade)
  relatedRun        AgentRun?       @relation(fields: [relatedRunId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([agentConfigId, createdAt])
  @@index([ceoAgentConfigId, createdAt])
  @@index([userId, createdAt])
}

// Durable CEO Plan — executive intent/memory across conversations.
// Encrypted body holds objective, situation, decisions, open items, actions.
// Plans never grant tool permissions or execution authority (see server/brain/plans.js).
model Plan {
  id                   String     @id @default(cuid())
  userId               String
  // Short plaintext label for lists (same treatment as conversation titles).
  title                String
  status               PlanStatus @default(ACTIVE)
  // Encrypted structured body (PlanBodyV1) — never log decrypted contents.
  contentCiphertext    String
  // Scope key for independent concurrent plans. Null/default = primary mission.
  // At most one ACTIVE plan per (userId, missionScope) — enforced in app code.
  missionScope         String?
  // Advisory planning horizon: "weeks" | "months" | "quarters".
  horizon              String?
  sourceConversationId String?
  lastReviewedAt       DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, updatedAt])
  @@index([userId, missionScope, status])
}

// Freedom Brain background work queue. The chat critical path only ever
// ENQUEUES rows here (memory extraction after a Brain reply, etc.); workers
// process them best-effort right after the response and the 15-minute cron
// sweeps anything left PENDING (serverless functions cannot guarantee
// post-response work). payload holds row IDs only — never plaintext content.
model BrainJob {
  id          String         @id @default(cuid())
  userId      String
  // Job kind: "memory_extraction" now; briefings/titles later.
  kind        String
  // Minimized reference payload (conversationId, messageId, …) — IDs only.
  payload     Json?
  status      BrainJobStatus @default(PENDING)
  attempts    Int            @default(0)
  runAfter    DateTime       @default(now())
  // Claim marker so the post-response worker and the cron sweep never
  // double-process the same job.
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime       @default(now())
  completedAt DateTime?
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@index([userId, kind, createdAt])
}

// ── Freedom OS Module 03: CHIEF ──────────────────────────────────────────────
//
// All CHIEF state lives in `chief_`-prefixed tables (docs/CHIEF_ARCHITECTURE.md
// §5.4). Table shapes are ported from the audited upstreams (provenance in
// docs/CHIEF_GITHUB_REUSE_AUDIT.md §8 and THIRD_PARTY_NOTICES.md):
//   - checkpoint tables (session/transcript_delta/execution_journal/
//     event_journal/middleware_state): möbius checkpoint schema v10
//   - agent/trace/fact/knowledge/scheduler tables: OpenJarvis agents.db,
//     traces.db, FactStore, KG backend, scheduler
//   - approval/capability tables: möbius approval semantics + OpenJarvis RBAC
// Cross-cutting rules: RLS on every table (see the chief_foundation
// migration); the ONLY foreign key into non-CHIEF tables is User; sensitive
// text columns are encrypted at rest (…Ciphertext); pgvector `embedding`
// columns are created conditionally by the migration (FTS/recency-only
// fallback when the extension is unavailable) and are declared Unsupported so
// the Prisma client never selects them directly.

enum ChiefSessionStatus {
  ACTIVE
  PENDING_APPROVAL
  ARCHIVED
}

// OpenJarvis FactStore trust tiers: external information never automatically
// becomes trusted memory. AUTO = automatically extracted, pending review.
enum ChiefTrustTier {
  AUTO
  TRUSTED
  UNTRUSTED
}

// möbius ReviewDecision variants plus PENDING for a not-yet-decided request.
enum ChiefApprovalDecision {
  PENDING
  APPROVED
  APPROVED_FOR_SESSION
  DENIED
  ABORTED
}

enum ChiefTaskKind {
  ONCE
  INTERVAL
  CRON
}

enum ChiefScheduledTaskStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ChiefTaskRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  AWAITING_APPROVAL
  RETRYING
}

// OpenJarvis Trace step taxonomy.
enum ChiefTraceStepType {
  ROUTE
  RETRIEVE
  GENERATE
  TOOL_CALL
  RESPOND
}

// Knowledge-graph relation origin (matches cortex-map's edge model).
enum ChiefRelationOrigin {
  EXPLICIT
  SEMANTIC
}

// One durable CHIEF conversation/checkpoint root (möbius `sessions`).
// PENDING_APPROVAL is the suspended-turn state: any serverless instance can
// resume the turn from the journals below after an ExecApproval Op arrives.
model ChiefSession {
  id                  String             @id @default(cuid())
  userId              String
  title               String?
  status              ChiefSessionStatus @default(ACTIVE)
  // Version of the checkpoint payload layout (möbius rejects on mismatch;
  // CHIEF migrates forward via Prisma migrations — documented deviation).
  checkpointVersion   Int                @default(1)
  // SessionContext (owner/workspace/origin labels) — correlation metadata
  // only, never authorization (möbius SessionContext rule).
  contextJson         Json?
  modelRoute          String?
  // Checkpoint fork support (möbius `fork`): a forked session records its
  // parent; deleting the parent must not destroy the fork.
  forkedFromSessionId String?
  // Monotonic checkpoint sequence; incremented by each atomic saveWithEvents.
  lastSequence        Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  forkedFromSession   ChiefSession?      @relation("ChiefSessionFork", fields: [forkedFromSessionId], references: [id], onDelete: SetNull)
  forkedSessions      ChiefSession[]     @relation("ChiefSessionFork")
  transcriptDeltas    ChiefTranscriptDelta[]
  executionJournal    ChiefExecutionJournal[]
  eventJournal        ChiefEventJournal[]
  middlewareStates    ChiefMiddlewareState[]

  @@index([userId, updatedAt])
  @@index([userId, status])
  @@map("chief_session")
}

// Append-only model-context deltas per checkpoint sequence (möbius
// `transcript_delta`). Provider-private data never enters checkpoints.
model ChiefTranscriptDelta {
  id              String       @id @default(cuid())
  userId          String
  sessionId       String
  sequence        Int
  itemsCiphertext String
  createdAt       DateTime     @default(now())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session         ChiefSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([userId])
  @@map("chief_transcript_delta")
}

// Durable execution state per checkpoint sequence (möbius
// `execution_journal`): turn phase machine position, pending tool batch,
// pending approval — everything needed to resume a suspended turn.
model ChiefExecutionJournal {
  id              String       @id @default(cuid())
  userId          String
  sessionId       String
  sequence        Int
  turnId          String?
  // Turn phase at save time (prepare/model/tool_authorize/execute/completion).
  phase           String?
  stateCiphertext String
  createdAt       DateTime     @default(now())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session         ChiefSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([userId])
  @@map("chief_execution_journal")
}

// Frontend events journaled in the same transaction as the checkpoint
// (möbius `event_journal`) — the activity history is replayable.
model ChiefEventJournal {
  id                String       @id @default(cuid())
  userId            String
  sessionId         String
  sequence          Int
  eventIndex        Int
  submissionId      String?
  // EventMsg wire tag, plaintext for filtering; payload is encrypted.
  eventType         String
  payloadCiphertext String
  createdAt         DateTime     @default(now())
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session           ChiefSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence, eventIndex])
  @@index([userId, createdAt])
  @@map("chief_event_journal")
}

// Per-middleware durable state (möbius `middleware_state`).
model ChiefMiddlewareState {
  id              String       @id @default(cuid())
  userId          String
  sessionId       String
  middlewareId    String
  stateCiphertext String
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session         ChiefSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, middlewareId])
  @@index([userId])
  @@map("chief_middleware_state")
}

// Managed-agent lifecycle (OpenJarvis `agents.db`): tick stats and a rolling
// summary maintained by scheduler ticks.
model ChiefAgent {
  id                String    @id @default(cuid())
  userId            String
  name              String
  purpose           String?
  // Open string on purpose (idle/running/paused/stopped) — no migration per
  // new lifecycle state.
  status            String    @default("idle")
  configJson        Json?
  tickCount         Int       @default(0)
  lastTickAt        DateTime?
  statsJson         Json?
  summaryCiphertext String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks             ChiefAgentTask[]
  messages          ChiefAgentMessage[]

  @@index([userId])
  @@map("chief_agent")
}

// Work items owned by a managed agent (OpenJarvis agent task queue).
model ChiefAgentTask {
  id                    String     @id @default(cuid())
  userId                String
  agentId               String
  status                String     @default("pending")
  descriptionCiphertext String?
  resultCiphertext      String?
  createdAt             DateTime   @default(now())
  startedAt             DateTime?
  completedAt           DateTime?
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent                 ChiefAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([userId, createdAt])
  @@map("chief_agent_task")
}

// Agent-to-agent / user-to-agent messages (OpenJarvis agent inbox).
model ChiefAgentMessage {
  id                String     @id @default(cuid())
  userId            String
  agentId           String
  fromAgentId       String?
  contentCiphertext String
  readAt            DateTime?
  createdAt         DateTime   @default(now())
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent             ChiefAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("chief_agent_message")
}

// One completed (or in-flight) turn/run trace (OpenJarvis `traces.db`).
// Correlation ids are plain strings, not FKs, so the audit trail survives
// session/agent deletion.
model ChiefTrace {
  id               String    @id @default(cuid())
  userId           String
  sessionId        String?
  turnId           String?
  agentId          String?
  model            String?
  tokensInput      Int?
  tokensOutput     Int?
  estimatedCostUsd Decimal?  @db.Decimal(10, 6)
  outcome          String?
  // Learning signal (FEEDBACK_RECEIVED events land here).
  feedback         Int?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps            ChiefTraceStep[]

  @@index([userId, startedAt])
  @@index([sessionId, startedAt])
  @@map("chief_trace")
}

// Typed steps within a trace (OpenJarvis TraceStep).
model ChiefTraceStep {
  id               String             @id @default(cuid())
  userId           String
  traceId          String
  stepIndex        Int
  stepType         ChiefTraceStepType
  name             String?
  status           String?
  detailCiphertext String?
  startedAt        DateTime           @default(now())
  completedAt      DateTime?
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  trace            ChiefTrace         @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@unique([traceId, stepIndex])
  @@index([userId])
  @@map("chief_trace_step")
}

// Long-term memory facts (OpenJarvis FactStore): trust tiers, importance/
// confidence, dedupe key, retention expiry. Content encrypted at rest.
model ChiefFact {
  id                String                 @id @default(cuid())
  userId            String
  contentCiphertext String
  dedupeKey         String
  trustTier         ChiefTrustTier         @default(AUTO)
  source            String?
  importance        Float                  @default(0.5)
  confidence        Float                  @default(0.5)
  expiresAt         DateTime?
  lastAccessedAt    DateTime?
  // pgvector embedding; created conditionally by the migration. Unsupported
  // keeps it out of Prisma client selects (raw SQL only).
  embedding         Unsupported("vector")?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, trustTier])
  @@map("chief_fact")
}

// Knowledge-graph entities (OpenJarvis KG backend). Name/type are plaintext
// (retrieval fallback runs FTS over them); attribute payload is encrypted.
model ChiefKnowledgeEntity {
  id                   String                 @id @default(cuid())
  userId               String
  name                 String
  entityType           String?
  weight               Float                  @default(1)
  // cortex-map node role (core|hub|subhub|leaf) — assigned by consolidation.
  nodeRole             String?
  attributesCiphertext String?
  embedding            Unsupported("vector")?
  lastSeenAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoingRelations    ChiefKnowledgeRelation[] @relation("ChiefRelationSource")
  incomingRelations    ChiefKnowledgeRelation[] @relation("ChiefRelationTarget")

  @@unique([userId, name])
  @@map("chief_knowledge_entity")
}

// Knowledge-graph relations (OpenJarvis KG backend); `origin` distinguishes
// explicit relations from semantic auto-links (embed → cosine-KNN concept —
// jarvis-architecture, REFERENCE ONLY).
model ChiefKnowledgeRelation {
  id               String               @id @default(cuid())
  userId           String
  sourceEntityId   String
  targetEntityId   String
  relationType     String
  origin           ChiefRelationOrigin  @default(EXPLICIT)
  weight           Float                @default(1)
  lastReinforcedAt DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEntity     ChiefKnowledgeEntity @relation("ChiefRelationSource", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity     ChiefKnowledgeEntity @relation("ChiefRelationTarget", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceEntityId, targetEntityId, relationType])
  @@index([targetEntityId])
  @@map("chief_knowledge_relation")
}

// Background schedule definitions (OpenJarvis scheduler: once/interval/cron).
// lockedAt is the claim marker so concurrent cron invocations never
// double-process a task (same pattern as BrainJob).
model ChiefScheduledTask {
  id              String                   @id @default(cuid())
  userId          String
  name            String
  kind            ChiefTaskKind
  cronExpr        String?
  intervalSeconds Int?
  runAt           DateTime?
  payload         Json?
  agentId         String?
  status          ChiefScheduledTaskStatus @default(ACTIVE)
  nextRunAt       DateTime?
  lastRunAt       DateTime?
  lockedAt        DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs            ChiefTaskRun[]

  @@index([status, nextRunAt])
  @@index([userId])
  @@map("chief_scheduled_task")
}

// Execution records for scheduled tasks (möbius routine_runs semantics:
// status + retry counters). SetNull so run history survives task deletion.
model ChiefTaskRun {
  id               String              @id @default(cuid())
  userId           String
  scheduledTaskId  String?
  status           ChiefTaskRunStatus  @default(RUNNING)
  attempts         Int                 @default(0)
  sessionId        String?
  error            String?
  resultCiphertext String?
  startedAt        DateTime            @default(now())
  completedAt      DateTime?
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledTask    ChiefScheduledTask? @relation(fields: [scheduledTaskId], references: [id], onDelete: SetNull)

  @@index([scheduledTaskId, startedAt])
  @@index([userId, startedAt])
  @@index([status, startedAt])
  @@map("chief_task_run")
}

// Approval requests + decisions (möbius approval semantics + OpenJarvis
// ApprovalStore). sessionId/turnId are plain correlation strings so the
// approval audit trail is immutable. stickyKey holds the SHA-256 session
// approval key for APPROVED_FOR_SESSION decisions (capped in app logic at
// MAX_SESSION_APPROVALS per session — server/chief/runtime/approvals.js).
model ChiefApproval {
  id               String                @id @default(cuid())
  userId           String
  sessionId        String?
  turnId           String?
  reason           String
  // The paused tool batch (call ids, names, arguments) — encrypted: tool
  // arguments can contain sensitive content.
  callsCiphertext  String
  decision         ChiefApprovalDecision @default(PENDING)
  rejectionReason  String?
  stickyKey        String?
  decidedAt        DateTime?
  createdAt        DateTime              @default(now())
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionId, stickyKey])
  @@map("chief_approval")
}

// RBAC capability grants/denies (OpenJarvis CapabilityPolicy persistence).
// agentId is a plain string: the `_default` wildcard agent is a valid id.
model ChiefCapabilityGrant {
  id         String   @id @default(cuid())
  userId     String
  agentId    String
  capability String
  pattern    String   @default("*")
  deny       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, agentId])
  @@map("chief_capability_grant")
}

// Immutable audit log for privileged CHIEF actions (capability denials,
// approval decisions, budget events, admin operations).
model ChiefAuditLog {
  id               String   @id @default(cuid())
  userId           String
  actor            String?
  action           String
  resource         String?
  summary          String?
  detailCiphertext String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chief_audit_log")
}

// Spend caps per scope/period (budget-cap concept from jarvis-architecture —
// REFERENCE ONLY; implementation is CHIEF's own on this schema).
model ChiefBudget {
  id          String    @id @default(cuid())
  userId      String
  scope       String    @default("global")
  periodType  String    @default("month")
  capUsd      Decimal   @db.Decimal(12, 6)
  spentUsd    Decimal   @default(0) @db.Decimal(12, 6)
  periodStart DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, periodType])
  @@map("chief_budget")
}

// Self-notification only: agents may notify the user (in-app or via the
// user's own verified email), never any third party.
model Notification {
  id            String              @id @default(cuid())
  userId        String
  agentConfigId String?
  title         String
  body          String
  channel       NotificationChannel @default(IN_APP)
  readAt        DateTime?
  createdAt     DateTime            @default(now())
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentConfig   AgentConfig?        @relation(fields: [agentConfigId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
