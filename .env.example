# ─────────────────────────────────────────────────────────────────────────────
# Forward Freedom — Environment Variables
# Copy to .env.local and fill in your values. Never commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# Client-side Firebase configuration (safe for browser env vars)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
# Optional, only if you use Firebase Storage
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Server-side Firebase Admin configuration
# Use either the individual values below OR the full JSON payload.
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
# FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}

# ── Firebase console — required before going to production ────────────────────
# 1. Authentication > Settings > User actions: enable "Email verified" enforcement
#    or add email verification to your sign-up flow so unverified users cannot
#    link bank accounts (the server enforces this at the API level).
# 2. Enable the Google sign-in provider OR ensure all users verify email.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres / Prisma
# DATABASE_URL is used by the app at runtime. On serverless hosts (Vercel) with
# Supabase, this should be the Supavisor *transaction pooler* connection
# (port 6543, with `?pgbouncer=true`) so the app doesn't exhaust Postgres
# connections.
DATABASE_URL=postgresql://postgres:password@db-host:5432/forward_freedom

# DIRECT_URL is used only by the Prisma CLI (migrate deploy/dev, db push) at
# build/dev time. Poolers in transaction mode can't run schema migrations, so
# on Supabase this must be the *session pooler or direct* connection
# (port 5432, no pgbouncer param). Optional for local dev if DATABASE_URL is
# already a direct connection; required in production when DATABASE_URL is a
# transaction-mode pooler URL.
# DIRECT_URL=postgresql://postgres:password@db-host:5432/forward_freedom

# SERVICE_DATABASE_URL connects as the freedom_service role (BYPASSRLS) and is
# used ONLY by server/db/servicePrisma.js for the few legitimately cross-user
# lookups (Plaid webhook item_id → userId resolution, future cron dispatcher,
# future admin usage queries). After the RLS rollout, DATABASE_URL should point
# at the RLS-restricted freedom_app role and this at freedom_service (see
# docs/RLS_ROLLOUT.md). Leave unset before the rollout.
# SERVICE_DATABASE_URL=postgresql://freedom_service:password@db-host:6543/forward_freedom?pgbouncer=true

# ── Plaid ─────────────────────────────────────────────────────────────────────
# PLAID_ENV: use "development" for test institutions and "production" for real bank accounts.
# Production requires Plaid approval — request access at https://dashboard.plaid.com
PLAID_ENV=development
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret

# ── Data-at-rest encryption (envelope encryption) ────────────────────────────
# All sensitive financial data (Plaid access tokens, account balances,
# transaction amounts/merchants/categories, liability details, and the manual
# workspace blob) is encrypted at rest with envelope encryption. Keys are
# versioned so they can be rotated WITHOUT users reconnecting Plaid.
#
# Preferred configuration — a versioned keyring of 32-byte base64 keys:
#   Generate a key with: openssl rand -base64 32
# FFF_ENCRYPTION_KEYS="1:<base64-32-byte-key>"
# FFF_ENCRYPTION_ACTIVE_VERSION="1"
#
# To rotate: add a new version, make it active, then run
#   node scripts/encrypt-backfill.mjs --rotate
# Keep the previous version(s) in FFF_ENCRYPTION_KEYS until rotation completes.
#
# Backwards-compatible fallback: if FFF_ENCRYPTION_KEYS is unset but the legacy
# PLAID_TOKEN_ENCRYPTION_KEY (32+ chars) is present, a key is derived from it so
# existing deployments keep working. Legacy-encrypted values decrypt and are
# transparently re-wrapped on next write. Generate with: openssl rand -base64 40
PLAID_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret_at_least_32_chars

# Optional: webhook URL for real-time transaction updates (recommended in production)
# Set this to your deployed /api/plaid/webhook endpoint after enabling Plaid webhooks.
# PLAID_WEBHOOK_URL=https://your-app.example.com/api/plaid/webhook

# Optional: OAuth return page for Plaid Link, required only to support
# OAuth-based institutions (many large banks).
# Set this to your deployed /plaid-oauth.html page AND register the exact same
# URL under Plaid Dashboard > Allowed redirect URIs. Plaid rejects link token
# creation with INVALID_FIELD if a redirect_uri is sent that is not registered,
# so leave this unset until the URL has been added to the dashboard.
# PLAID_OAUTH_REDIRECT_URI=https://www.forwardfreedomfinancial.com/plaid-oauth.html

# ── Freedom OS agent platform ─────────────────────────────────────────────────
# Server-only secrets for the multi-agent platform (CEO Agent + sub-agents).
# None of these may use the VITE_ prefix — they must never reach the browser.

# Platform-wide Anthropic API key used for all agent LLM calls. One shared key
# for the whole platform; users never supply their own.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Shared secret that authenticates Vercel Cron requests to the agent
# dispatcher endpoint (api/cron/agent-dispatch.js).
# Generate with: openssl rand -base64 32
CRON_SECRET=replace_with_a_long_random_secret

# Resend API key for agent self-notification emails (sent only to the user's
# own verified email address).
RESEND_API_KEY=your_resend_api_key

# ── Production checklist ──────────────────────────────────────────────────────
# Before connecting real bank accounts:
# [ ] Set PLAID_ENV=production and use production Plaid credentials
# [ ] Set FFF_ENCRYPTION_KEYS (+ FFF_ENCRYPTION_ACTIVE_VERSION) to strong,
#     unique, securely-stored 32-byte keys (or PLAID_TOKEN_ENCRYPTION_KEY)
# [ ] Enable email verification in Firebase Auth console
# [ ] Configure rate limiting at the edge (Vercel: add Vercel Firewall rules,
#     or enable the built-in DDoS protection on Pro/Enterprise plans)
# [ ] Set up Postgres with backups and access control (access tokens are
#     encrypted but the DB still holds financial PII)
# [ ] Optionally set PLAID_WEBHOOK_URL for real-time sync
# ─────────────────────────────────────────────────────────────────────────────
