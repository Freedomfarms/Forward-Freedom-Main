# ─────────────────────────────────────────────────────────────────────────────
# Forward Freedom — Environment Variables
# Copy to .env.local and fill in your values. Never commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# Client-side Firebase configuration (safe for browser env vars)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
# Optional, only if you use Firebase Storage
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Server-side Firebase Admin configuration
# Use either the individual values below OR the full JSON payload.
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
# FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}

# ── Firebase console — required before going to production ────────────────────
# 1. Authentication > Settings > User actions: enable "Email verified" enforcement
#    or add email verification to your sign-up flow so unverified users cannot
#    link bank accounts (the server enforces this at the API level).
# 2. Enable the Google sign-in provider OR ensure all users verify email.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres / Prisma
DATABASE_URL=postgresql://postgres:password@db-host:5432/forward_freedom

# ── Plaid ─────────────────────────────────────────────────────────────────────
# PLAID_ENV: use "sandbox" for testing, "production" for real bank accounts.
# Production requires Plaid approval — request access at https://dashboard.plaid.com
PLAID_ENV=sandbox
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret

# REQUIRED: 32+ character random secret used to AES-256 encrypt Plaid access tokens
# before storing them in the database. Generate with: openssl rand -base64 40
# Rotating this key will require re-linking all bank accounts.
PLAID_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret_at_least_32_chars

# Optional: webhook URL for real-time transaction updates (recommended in production)
# PLAID_WEBHOOK_URL=https://your-app.example.com/api/plaid/webhook

# ── Production checklist ──────────────────────────────────────────────────────
# Before connecting real bank accounts:
# [ ] Set PLAID_ENV=production and use production Plaid credentials
# [ ] Set PLAID_TOKEN_ENCRYPTION_KEY to a strong, unique, stored-securely value
# [ ] Enable email verification in Firebase Auth console
# [ ] Configure rate limiting at the edge (Vercel: add Vercel Firewall rules,
#     or enable the built-in DDoS protection on Pro/Enterprise plans)
# [ ] Set up Postgres with backups and access control (access tokens are
#     encrypted but the DB still holds financial PII)
# [ ] Optionally set PLAID_WEBHOOK_URL for real-time sync
# ─────────────────────────────────────────────────────────────────────────────
