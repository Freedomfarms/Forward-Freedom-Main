{
  "manifest_version": 3,
  "name": "Freedom OS capture",
  "version": "0.1.0",
  "description": "Opt-in capture of completed Claude and ChatGPT conversations into your Freedom OS archive.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*"],
      "js": ["content.js"],
      "type": "module",
      "run_at": "document_idle"
    }
  ]
}
